{
  "manifest_version": 3,
  "name": "MAST Instagram Reply Bridge",
  "version": "1.0.0",
  "description": "Passively detects replies from contacted MAST leads while Instagram Direct is open in your browser.",
  "permissions": ["storage"],
  "host_permissions": [
    "https://www.instagram.com/*",
    "https://*/*",
    "http://localhost/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://www.instagram.com/direct/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "MAST IG Reply Bridge"
  }
}
