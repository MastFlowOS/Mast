{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "enables the default permissions",
  "windows": [
    "*"
  ],
  "webviews": [
    "*"
  ],
  "local": true,
  "remote": {
    "urls": [
      "https://*.vercel.app/*",
      "https://*.mast-flow.com/*",
      "https://mast-flow.com/*",
      "http://localhost:*/*",
      "http://127.0.0.1:*/*"
    ]
  },
  "permissions": [
    "core:default",
    "allow-desktop-worker-commands",
    "allow-get-desktop-info",
    "allow-get-worker-status",
    "allow-start-worker",
    "allow-stop-worker",
    "allow-update-worker-token",
    "allow-set-active-plan"
  ]
}

