{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "outDir": "dist",
    "rootDir": "src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "declaration": false,
    "sourceMap": true
  },
  "include": [
    "src/server.ts",
    "src/workers/index.ts",
    "src/config/env.ts",
    "src/config/plans.ts",
    "src/middleware/auth.ts",
    "src/server/routes/health.ts",
    "src/server/routes/account.ts",
    "src/server/routes/discover.ts",
    "src/server/routes/intelligence.ts",
    "src/server/routes/outreach.ts",
    "src/server/routes/inbox.ts",
    "src/server/routes/team.ts",
    "src/server/routes/booking.ts",
    "src/server/routes/safety.ts",
    "src/server/routes/observability.ts",
    "src/lib/queue.ts",
    "src/lib/supabaseAdmin.ts",
    "src/lib/json.ts",
    "src/lib/poolLookup.ts",
    "src/lib/aiAccess.ts",
    "src/lib/ai.ts",
    "src/lib/outreachPrompt.ts",
    "src/lib/intelligenceContext.ts",
    "src/lib/instagram.ts",
    "src/lib/inboxCrypto.ts",
    "src/lib/inboxHostValidator.ts",
    "src/lib/replyParsing.ts",
    "src/lib/replyTriage.ts",
    "src/lib/replyIngestion.ts",
    "src/lib/imapSync.ts",
    "src/lib/leadInvestigate.ts",
    "src/lib/teamSeats.ts",
    "src/lib/workspaceContext.ts",
    "src/lib/websiteAudit.ts",
    "src/lib/deliverability.ts",
    "src/jobs/**/*.ts",
    "src/scraperBridge/**/*.ts",
    "src/scoring/**/*.ts"
  ]
}
